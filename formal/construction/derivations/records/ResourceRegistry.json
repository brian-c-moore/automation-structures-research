  "cases": {
    "valid": [
      {
        "id": "register-new-key",
        "description": "Register installs the one requested key/value pair and frames every other key."
      },
      {
        "id": "replace-existing-key",
        "description": "Register filters the previous value and installs exactly one replacement atomically."
      }
    ],
    "boundary": [
      {
        "id": "deregister-present-key",
        "description": "Deregister removes every pair for a present key and frames every other key/value binding."
      },
      {
        "id": "absent-deregister-rejected",
        "description": "An absent key does not enable canonical Deregister; an executable admission wrapper must stutter."
      }
    ],
    "misuse": [
      {
        "id": "append-without-filter",
        "description": "Appending a replacement without filtering the prior pair permits DuplicateMapping and is rejected."
      },
      {
        "id": "presence-only-frame",
        "description": "Preserving only other-key presence while changing another key's value is not the declared action mapping."
      }
    ],
    "failure": [
      {
        "id": "torn-upsert",
        "description": "Exposing the filter and replacement as separate crash-visible commits is outside the model and loses atomic upsert."
      },
      {
        "id": "bypass-writer",
        "description": "An unregistered entries writer invalidates the owner and complete-TCB premises."
      }
    ]
  },
