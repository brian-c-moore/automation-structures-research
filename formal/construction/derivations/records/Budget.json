      "statement": "Every admitted ledger action preserves allocated + reserved + pending_eviction <= capacity.",
      "property_class": "safety",
      "kind": "prevention",
      "family": "obligation",
      "local_theorem": "Budget_Proof!SafetyInvariantSafety"
    },
    {
      "id": "guarded-commit-license",
      "statement": "An allocating or reserving write is licensed only by the atomic complete-ledger capacity check; rejected calls stutter.",
      "property_class": "safety",
      "kind": "prevention",
      "family": "check-act",
      "local_theorem": "TheoryKernel_Proof!CheckActStability"
    },
    {
      "id": "budget-owner-ceiling",
      "statement": "Prevention is conditional on the budget authority owning the atomic ledger commit; an external bypass loses that result.",
      "property_class": "safety",
      "kind": "conditional",
      "family": "ownership-assurance",
      "local_theorem": "OwnershipAssuranceKernel_Proof!OwnershipAssuranceClassification"
    },
    {
      "id": "budget-executable-transfer",
      "statement": "A conforming executable inherits only capacity preservation for the mapped six-action surface.",
      "property_class": "safety",
      "kind": "conditional",
      "family": "refinement",
      "local_theorem": "BudgetImplRefinesSpec_Proof!RefinementThm"
    }
  ],
