    "valid": [
      {
        "id": "allocate-within-headroom",
        "description": "A positive amount whose complete-ledger total fits is atomically added to allocated."
      },
      {
        "id": "reservation-lifecycle",
        "description": "Reserve, commit reservation, mark eviction, and complete eviction transfer or remove the same amount with exact frames."
      }
    ],
    "boundary": [
      {
        "id": "exact-capacity",
        "description": "A write reaching exactly capacity is admitted and preserves the non-strict bound."
      },
      {
        "id": "rejected-overspend-stutter",
        "description": "TryAllocate or Reserve above headroom changes no governed field."
      }
    ],
    "misuse": [
      {
        "id": "split-check-and-commit",
        "description": "A capacity check separated from its write without a stability proof does not inherit guarded-commit licensing."
      },
      {
        "id": "omitted-ledger-term",
        "description": "A check omitting reserved or pending_eviction is rejected as a materially wrong mapping."
      }
    ],
    "failure": [
      {
        "id": "torn-ledger-update",
        "description": "A partially visible transfer or non-atomic shared store lies outside the model and loses prevention."
      },
      {
        "id": "bypass-writer",
        "description": "A writer outside the inventoried budget authority invalidates the owner and TCB premises."
      }
    ]
  },
