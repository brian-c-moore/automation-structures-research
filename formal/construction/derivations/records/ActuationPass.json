    {
      "id": "actuationpass-written-profile-refinement",
      "statement": "Mechanized refinement maps the written executable contract profile to the canonical ActuationPass machine under the named state, action, and premise map.",
      "property_class": "safety",
      "kind": "conditional",
      "family": "refinement",
      "local_theorem": "ActuationPassImplRefinesSpec_Proof!RefinementThm"
    },
    {
      "id": "effect-fidelity",
      "statement": "Every recorded effect names the live allocated resource at the governed actuation commit.",
      "property_class": "safety",
      "kind": "prevention",
      "family": "obligation",
      "local_theorem": "ActuationPass_Proof!EffectFidelitySafety"
    },
    {
      "id": "truthful-pass-closure",
      "statement": "Finish records closure only when every currently allocated seat has a recorded effect; ActuationScope follows from fidelity.",
      "property_class": "safety",
      "kind": "prevention",
      "family": "obligation",
      "local_theorem": "ActuationPass_Proof!PassCompletenessSafety and ActuationScopeSafety"
    },
    {
      "id": "fused-actuation-and-finish-license",
      "statement": "The allocation read/effect record and the completeness check/finish flag are each fused at their governed commit.",
      "property_class": "safety",
      "kind": "prevention",
      "family": "check-act",
      "local_theorem": "TheoryKernel_Proof!CheckActStability"
    },
    {
      "id": "actuation-owner-ceiling",
      "statement": "Prevention applies only to the recorded effect and closure commits controlled by the actuation owner under the named allocation rely.",
      "property_class": "safety",
      "kind": "conditional",
      "family": "ownership-assurance",
      "local_theorem": "OwnershipAssuranceKernel_Proof!OwnershipAssuranceClassification"
    },
    {
