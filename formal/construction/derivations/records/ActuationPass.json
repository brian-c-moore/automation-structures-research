  "cases": {
    "valid": [
      {
        "id": "fused-actuation",
        "description": "Actuate reads a non-NULL allocation and records that same resource in one pass-owned commit."
      },
      {
        "id": "truthful-finish",
        "description": "Finish sets complete only after every currently allocated seat has a non-NULL effect record."
      }
    ],
    "boundary": [
      {
        "id": "empty-pass-finish",
        "description": "A pass with no allocated seats may finish because the completeness condition is vacuous over seats, not over obligations."
      },
      {
        "id": "unapplied-deallocation",
        "description": "The allocation provider may withdraw only a seat whose effect is still NULL before closure."
      }
    ],
    "misuse": [
      {
        "id": "split-allocation-read-effect-write",
        "description": "Separating the allocation read from the effect record admits a deallocation race and loses fidelity."
      },
      {
        "id": "finish-with-pending-seat",
        "description": "Setting complete while an allocated seat remains unapplied violates PassCompleteness."
      }
    ],
    "failure": [
      {
        "id": "external-effect-fails-after-record",
        "description": "A recorded effect with a failed external side effect remains possible outside the model and transfers no effect-success claim."
      },
      {
        "id": "withdraw-after-effect",
        "description": "Allocation withdrawal after actuation but before closure violates the named environment rely and ActuationScope."
      }
    ]
  },
