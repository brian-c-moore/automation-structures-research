    {
      "id": "propagationpass-written-profile-refinement",
      "statement": "Mechanized refinement maps the written executable contract profile to the canonical PropagationPass machine under the named state, action, and premise map.",
      "property_class": "safety",
      "kind": "conditional",
      "family": "refinement",
      "local_theorem": "PropagationPassImplRefinesSpec_Proof!RefinementThm"
    },
    {
      "id": "bounded-snapshot-rounds",
      "statement": "Every admitted action preserves the iteration ceiling and every updated node is computed from the common immutable round snapshot.",
      "property_class": "safety",
      "kind": "prevention",
      "family": "obligation",
      "local_theorem": "PropagationPassGraph_Proof!IterationBoundSafety and SnapshotLocalitySafety"
    },
    {
      "id": "eventual-settlement-or-limit",
      "statement": "For finite Nodes, under the named weak-fair scheduler obligations, execution eventually settles or reaches MaxIterations.",
