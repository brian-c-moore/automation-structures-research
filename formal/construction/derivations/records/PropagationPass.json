  "cases": {
    "valid": [
      {
        "id": "complete-snapshot-round",
        "description": "StartRound freezes values, each finite node updates once from snapshot, and EndRound charges exactly one iteration."
      },
      {
        "id": "fair-eventual-closure",
        "description": "The named scheduler eventually selects continuously enabled admission, node updates, and closure, yielding settled or MaxIterations."
      }
    ],
    "boundary": [
      {
        "id": "unchanged-round-settles",
        "description": "A fully covered round with values = snapshot sets changed false and satisfies closure."
      },
      {
        "id": "iteration-ceiling",
        "description": "At MaxIterations no new round is admitted and the temporal disjunction is closed by the ceiling."
      }
    ],
    "misuse": [
      {
        "id": "live-value-combine",
        "description": "Reading values instead of the frozen snapshot during UpdateNode is rejected as a locality mismatch."
      },
      {
        "id": "safety-only-progress-surrogate",
        "description": "IterationBound or monotone state alone cannot stand in for EventualSettledOrIterationLimitProved."
      }
    ],
    "failure": [
      {
        "id": "fairness-provider-absent",
        "description": "Removing the workflow scheduler's weak fairness retains an infinite non-progress behavior."
      },
      {
        "id": "round-state-loss",
        "description": "Executor crash or loss of snapshot/updated state is outside the model and transfers no recovery claim."
      }
    ]
  },
