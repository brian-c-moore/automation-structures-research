      "kind": "conditional",
      "family": "progress",
      "local_theorem": "PropagationPassGraph_Proof!EventualSettledOrIterationLimitProved"
    },
    {
      "id": "propagation-owner-ceiling",
      "statement": "The safety result requires the propagation executor to own each atomic round-state commit; liveness additionally remains conditional on the workflow scheduler.",
      "property_class": "safety",
      "kind": "conditional",
      "family": "ownership-assurance",
      "local_theorem": "OwnershipAssuranceKernel_Proof!OwnershipAssuranceClassification"
    },
    {
      "id": "propagation-executable-transfer",
      "statement": "The mechanized implementation relation transfers bounded snapshot safety and only the proved eventual-closure result under the same fairness owner for the written profile.",
      "property_class": "liveness",
      "kind": "conditional",
      "family": "refinement",
      "local_theorem": "PropagationPassImplRefinesSpec_Proof!RefinementThm"
    }
