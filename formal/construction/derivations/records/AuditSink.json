  "cases": {
    "valid": [
      {
        "id": "atomic-record-append",
        "description": "Below MaxLogLen, Record appends operation, prior last_hash, and Hash(last_hash, operation) and advances last_hash atomically."
      },
      {
        "id": "conditional-content-attribution",
        "description": "Under HashCR, a stored hash is attributable to the record's own previous-hash/operation pair."
      }
    ],
    "boundary": [
      {
        "id": "empty-genesis",
        "description": "The empty log has last_hash zero and vacuously satisfies the three structural invariants."
      },
      {
        "id": "maximum-log-length",
        "description": "At MaxLogLen the executable try-record rejects and frames log and last_hash; the canonical Record action is disabled."
      }
    ],
    "misuse": [
      {
        "id": "claim-concrete-collision-resistance",
        "description": "The modulo-100 executable hash cannot discharge HashCR and must not advertise cryptographic collision resistance."
      },
      {
        "id": "unlinked-evidence-event",
        "description": "An observation without the mapped Record commit, claimant, owner, subject, and assurance binding is not attributable audit evidence."
      }
    ],
    "failure": [
      {
        "id": "record-loss-after-commit",
        "description": "If a named crash/storage failure erases the log, persistent evidence is false and detection/recovery cannot be inherited."
      },
      {
        "id": "hash-provider-violates-HashCR",
        "description": "A collision preserves a stored hash for distinct content and defeats only the conditional TamperEvident result."
      }
    ]
  },
