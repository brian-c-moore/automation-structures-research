  "cases": {
    "valid": [
      {
        "id": "begin-complete-pair",
        "description": "BeginStep sets the one active flag; CompleteStep appends one chosen value and advances the cursor once."
      },
      {
        "id": "terminal-stutter",
        "description": "At the inactive terminal cursor, DoneStuttering is enabled and changes no carrier field."
      }
    ],
    "boundary": [
      {
        "id": "first-step",
        "description": "The empty initial history and cursor zero remain aligned through the first begin/complete pair."
      },
      {
        "id": "out-of-domain-value-rejected",
        "description": "An executable next value outside the configured value domain cannot map to CompleteStep and must stutter."
      }
    ],
    "misuse": [
      {
        "id": "double-begin",
        "description": "A second BeginStep while active is disabled and cannot receive progress or commit credit."
      },
      {
        "id": "cursor-without-history",
        "description": "Advancing pc without appending the same completion value violates HistoryPositionAgreement."
      }
    ],
    "failure": [
      {
        "id": "crash-between-begin-and-complete",
        "description": "Crash, retry, and recovery while active are outside the carrier and transfer no exactly-once or persistence claim."
      },
      {
        "id": "hidden-parallel-effects",
        "description": "Parallel runtime work inside one visible step is not ruled out and cannot inherit an absence-of-concurrency claim."
      }
    ]
  },
